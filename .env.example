CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network
AAVE_ADAPTER_ADDRESS=0xDff00fde3829fFcA7A1dCAB0AA30602dd9F380A4
CREDITCOIN_PRIVATE_KEY=

# Background borrower watcher. The watcher only observes explicit public-address
# entries in address@first-source-block form. It is a no-write dry run unless
# launched with --submit and a funded CREDITCOIN_PRIVATE_KEY.
ETHEREUM_RPC_URL=
PROVER_BORROWER_WATCHLIST=
PROVER_AAVE_LOG_CHUNK_SIZE=10000

# Only required when deploying the FIFO or promise-event fixture to a supported
# Ethereum source network. Keep this key separate from the Creditcoin deployer.
SOURCE_RPC_URL=
SOURCE_PRIVATE_KEY=
